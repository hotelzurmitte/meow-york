	if (not (GameState.flag("o:hu7")) and (GameState.geld >= GameState.bierpreis()))
		do GameState.geld_aendern((0 - GameState.bierpreis()))
	do GameState.heilen(3)
	do EventBus.hinweis.emit("Die Gruppe erholt sich ein wenig (+3 TP)", "gut")
