~ r3n_f
do Kapitel.kampf(["orangoA","gorillaA","chimpA1","throwA"], "Don Orango & die Nomapes")
if GameState.flag("letzter_kampf_gewonnen")
	do GameState.set_flag("s3won")
else
	do GameState.set_flag("s3lost")
	do Kapitel.dialog_danach("r3_after")
