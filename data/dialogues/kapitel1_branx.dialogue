if not ((GameState.flag("fakeNephew") and not (GameState.flag("nephewJoke")))) and ((GameState.flag("hasTape") and GameState.flag("tapeLied")) and not (GameState.flag("orTapeAsk")))
	=> or_tapeAsk
if GameState.erneut("or_0")
	=> or_0__wieder
if not ((GameState.flag("hasTape")) or (not GameState.schon("or1")) or (GameState.flag("snaxHeard") and not GameState.schon("or2")) or (not (GameState.flag("auftrag"))) or (not GameState.schon("or4")))
	if GameState.flag("auftrag")
		Don Orango: Vincenzo. Cathattan. Worauf wartet ihr?
	else
		Don Orango: *kratzt sich mit dem Knüppel am Rücken* Später.
	=> END
if GameState.flag("or") and (GameState.flag("refusedOr") and not (GameState.flag("auftrag")))
	do GameState.set_flag("or")
	Don Orango: Na? Drüber geschlafen?
elif not (GameState.flag("or")) and (not (GameState.flag("prisoner")) and GameState.flag("refusedNugget"))
	do GameState.set_flag("or")
	Don Orango: *breitet die Arme aus* Willkommen bei den Nomapes. Nugget sagt, ihr seid euch zu fein für Arbeit. *grinst* Gefällt mir. Nugget kann nicht jeder leiden. Setzt euch.
elif GameState.flag("or")
	do GameState.set_flag("or")
	Don Orango: Was noch?
elif GameState.flag("prisoner")
	do GameState.set_flag("or")
	Don Orango: *sitzt auf einem Ölfass, der Nagelknüppel quer über den Knien* Doppelspieler. Wisst ihr, was ich mit Doppelspielern mache? Normalerweise.
elif not (GameState.flag("prisoner"))
	do GameState.set_flag("or")
	Don Orango: *breitet die Arme aus* Willkommen bei den Nomapes. Hier gibt's Bier, Matratzen und keine Bullen. Setzt euch.
