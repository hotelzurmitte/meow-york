; Meow-York – Godot-Projektdatei
config_version=5

[application]
config/name="Meow-York"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://scenes/tests/probe.tscn"

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[editor_plugins]

enabled=PackedStringArray("res://addons/asset_placer/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")
